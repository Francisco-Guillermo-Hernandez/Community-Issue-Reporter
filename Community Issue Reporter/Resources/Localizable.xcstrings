        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscá información relacionada con tu contenido como imágenes, comentarios y peticiones que violan nuestras directrices de la comunidad. Si tú crees que hemos actuado por error, puede presentar una apelación para que se revierta la medida."
          }
        },
        "en": {
          "stringUnit": {
